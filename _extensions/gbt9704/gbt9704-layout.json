{
  "$schema": "https://codeberg.org/songwupei/latex-gbt9704/raw/branch/main/gbt9704/gbt9704-layout-schema.json",
  "name": "通知类公文首页布局",
  "type": "notification-cover",
  "description": "通知类公文首页（红头版头 + 发文字号 + 红线 + 大标题 + 主送 + 正文起始 + 落款）的布局参数。对应 GB/T 9704-2012 §7.1-§7.3。",

  "colors": {
    "chinese_red": {
      "model": "RGB",
      "value": [200, 16, 46],
      "description": "公文红头及红线颜色。标准大红 #FF0000 → RGB(255,0,0)；部分单位使用暗红 #C8102E → RGB(200,16,46)。"
    }
  },

  "header_org": {
    "description": "红头 — 发文机关标志。居中、红色、紧缩排布。",
    "font_size": "\\zihao{0}",
    "font_size_pt": 42,
    "horizontal_scale": 0.75,
    "space_above": "10cm",
    "align": "center",
    "stroke_width": "0pt"
  },

  "header_number": {
    "description": "发文字号 — 红头下方、红线之上。仿宋体。",
    "font_size": "\\zihao{-3}",
    "font_size_pt": 15,
    "space_after_header_org": "0.5cm",
    "align": "center"
  },

  "redline": {
    "description": "红线 — 分隔版头与正文。红色、横贯版心。",
    "thickness": "1.5pt",
    "space_before": "0.1cm",
    "space_after": "0.3cm",
    "align": "center"
  },

  "title": {
    "description": "大标题 — 红线下方、主送上方。方正小标宋、居中。",
    "font_size": "\\zihao{2}",
    "font_size_pt": 22,
    "align": "center"
  },

  "mainreceiver": {
    "description": "主送机关 — 标题下方、正文上方。仿宋、顶格。长主送人（>25字）建议略小于三号以避免换行。",
    "font_size": "\\zihao{3}",
    "font_size_pt": 16,
    "align": "left",
    "indent": "0pt"
  },

  "body": {
    "description": "正文 — 仿宋、三号、28pt行距、首行缩进2字符。此为 GB/T 9704 标准值，一般不改动。",
    "font_size": "\\zihao{3}",
    "font_size_pt": 16,
    "line_spacing_pt": 28,
    "first_line_indent": "2\\ccwd"
  },

  "headings": {
    "description": "正文内标题层级。GB/T 9704: H1黑体 H2楷体 H3仿宋加粗，均为三号。",
    "h1": {
      "font_family": "heiti",
      "font_size": "\\zihao{3}",
      "font_weight": "bold"
    },
    "h2": {
      "font_family": "kaishu",
      "font_size": "\\zihao{3}",
      "font_weight": "bold"
    },
    "h3": {
      "font_family": "fangsong",
      "font_size": "\\zihao{3}",
      "font_weight": "bold"
    }
  },

  "signature": {
    "description": "发文机关署名 — 正文右下方。仿宋、右对齐。",
    "font_size": "\\zihao{3}",
    "font_size_pt": 16,
    "align": "right",
    "right_pad": "2\\ccwd"
  },

  "signdate": {
    "description": "成文日期 — 署名下方。仿宋、右对齐。",
    "font_size": "\\zihao{3}",
    "font_size_pt": 16,
    "align": "right",
    "right_pad": "2\\ccwd",
    "space_after_signature": "0pt"
  },

  "page_number": {
    "description": "页码 — 页面底端居中。四号、— N — 格式。",
    "font_size": "\\zihao{4}",
    "font_size_pt": 14,
    "align": "center",
    "format": "dash"
  }
}
